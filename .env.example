DB_USER=energy_user
DB_PASSWORD=energy_password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=smart_energy
DATABASE_URL=postgresql://energy_user:energy_password@postgres:5432/smart_energy
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=True
API_TITLE=Smart Energy Monitoring API
API_VERSION=1.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
MODEL_PATH=./ml/models/lstm_model.h5
BATCH_SIZE=32
EPOCHS=50
LOOKBACK_WINDOW=48
SYNTHETIC_DATA_ENABLED=True
SENSOR_COUNT=3
DATA_GENERATION_INTERVAL=60
REDIS_URL=redis://redis:6379
CACHE_EXPIRATION=3600